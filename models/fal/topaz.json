        { "name": "image", "data_type": "IMAGE", "api_field": "image_url", "required": true }
      ],
      "outputs": [
        { "name": "image", "data_type": "IMAGE", "api_field": "image" }
      ],
      "ref_roles": [
        { "role": "source", "api_field": "image_url", "max": 1 }
      ],
      "parameters": [
        { "name": "model", "label": "Mode", "type": "enum", "api_field": "model", "default": "Standard V2",
          "options": ["Standard V2", "High Fidelity V2", "Low Resolution V2", "CGI", "Text Refine", "Wonder 3", "Wonder", "Standard MAX", "Redefine", "Recovery V2", "Recovery"] },
        { "name": "upscale_factor", "label": "Scale", "type": "float", "api_field": "upscale_factor", "default": 2, "min": 1, "max": 4, "step": 0.25 },
        { "name": "output_format", "label": "Format", "type": "enum", "api_field": "output_format", "default": "jpeg", "options": ["jpeg", "png"] },
        { "name": "subject_detection", "label": "Subject", "type": "enum", "api_field": "subject_detection", "default": "All", "options": ["All", "Foreground", "Background"] },
        { "name": "face_enhancement", "label": "Face enhance", "type": "bool", "api_field": "face_enhancement", "default": true },
