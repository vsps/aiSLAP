{
  "$schema": "../../docs/model.schema.json",
  "provider": "fal",
  "family": "MiniMax H3 Max",
  "category": "fal.ai/Video Generation",
  "nodes": [
    {
      "id": "minimax_h3_max_txt2vid",
      "name": "MiniMax H3 Max (txt2vid)",
      "endpoint": "minimax/h3-max/text-to-video",
      "inputs": [
        { "name": "prompt", "data_type": "STRING", "api_field": "prompt", "required": true }
      ],
      "outputs": [
        { "name": "video", "data_type": "VIDEO", "api_field": "video" }
      ],
      "parameters": [
        { "name": "resolution", "label": "Resolution", "type": "enum", "api_field": "resolution", "default": "768P", "options": ["480P", "768P"] },
        { "name": "aspect_ratio", "label": "Aspect Ratio", "type": "enum", "api_field": "aspect_ratio", "default": "16:9", "options": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"] },
        { "name": "duration", "label": "Duration", "type": "int", "api_field": "duration", "default": 5, "min": 5, "max": 15 },
        { "name": "prompt_expansion_mode", "label": "Prompt Expansion", "type": "enum", "api_field": "prompt_expansion_mode", "default": "balanced", "options": ["balanced", "quality"] },
        { "name": "enable_safety_checker", "label": "Safety Checker", "type": "bool", "api_field": "enable_safety_checker", "default": true },
        { "name": "seed", "label": "Seed", "type": "int", "api_field": "seed", "default": -1, "min": -1, "max": 2147483647 }
      ]
    },
    {
      "id": "minimax_h3_max_img2vid",
      "name": "MiniMax H3 Max (img2vid)",
      "endpoint": "minimax/h3-max/image-to-video",
      "inputs": [
        { "name": "prompt", "data_type": "STRING", "api_field": "prompt", "required": true },
        { "name": "start_image", "data_type": "IMAGE", "api_field": "image_url", "required": true },
        { "name": "end_image", "data_type": "IMAGE", "api_field": "end_image_url" }
      ],
      "outputs": [
        { "name": "video", "data_type": "VIDEO", "api_field": "video" }
      ],
      "ref_roles": [
        { "role": "start", "api_field": "image_url", "max": 1 },
        { "role": "end", "api_field": "end_image_url", "max": 1 }
      ],
      "parameters": [
        { "name": "resolution", "label": "Resolution", "type": "enum", "api_field": "resolution", "default": "768P", "options": ["480P", "768P"] },
        { "name": "duration", "label": "Duration", "type": "int", "api_field": "duration", "default": 5, "min": 5, "max": 15 },
        { "name": "prompt_expansion_mode", "label": "Prompt Expansion", "type": "enum", "api_field": "prompt_expansion_mode", "default": "balanced", "options": ["balanced", "quality"] },
        { "name": "enable_safety_checker", "label": "Safety Checker", "type": "bool", "api_field": "enable_safety_checker", "default": true },
        { "name": "seed", "label": "Seed", "type": "int", "api_field": "seed", "default": -1, "min": -1, "max": 2147483647 }
      ]
    }
  ]
}
