{
  "$schema": "../../docs/model.schema.json",
  "provider": "bytedance",
  "family": "Seedance 2.5",
  "category": "ByteDance/Video Generation",
  "nodes": [
    {
      "id": "bytedance_seedance25_txt2vid",
      "name": "Seedance 2.5 (txt2vid)",
      "endpoint": "dreamina-seedance-2-5-260628",
      "inputs": [
        { "name": "prompt", "data_type": "STRING", "api_field": "prompt", "required": true }
      ],
      "outputs": [
        { "name": "video", "data_type": "VIDEO", "api_field": "video" }
      ],
      "parameters": [
        { "name": "resolution", "label": "Resolution", "type": "enum", "api_field": "resolution", "default": "720p", "options": ["480p", "720p", "1080p"] },
        { "name": "ratio", "label": "Aspect Ratio", "type": "enum", "api_field": "ratio", "default": "adaptive", "options": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"] },
        { "name": "duration", "label": "Duration (sec)", "type": "int", "api_field": "duration", "default": 8, "min": 4, "max": 30 },
        { "name": "generate_audio", "label": "Audio", "type": "bool", "api_field": "generate_audio", "default": true },
        { "name": "output_format", "label": "Output Format", "type": "enum", "api_field": "output_format", "default": "mp4", "options": ["mp4", "mov"] },
        { "name": "watermark", "label": "Watermark", "type": "bool", "api_field": "watermark", "default": false }
      ]
    },
    {
      "id": "bytedance_seedance25_img2vid",
      "name": "Seedance 2.5 (img2vid)",
      "endpoint": "dreamina-seedance-2-5-260628",
      "inputs": [
        { "name": "prompt", "data_type": "STRING", "api_field": "prompt", "required": true },
        { "name": "first_frame", "data_type": "IMAGE", "api_field": "first_frame_url", "required": true },
        { "name": "last_frame", "data_type": "IMAGE", "api_field": "last_frame_url" }
      ],
      "outputs": [
        { "name": "video", "data_type": "VIDEO", "api_field": "video" }
      ],
      "ref_roles": [
        { "role": "start", "api_field": "first_frame_url", "max": 1, "exclusive": true },
        { "role": "end", "api_field": "last_frame_url", "max": 1, "exclusive": true }
      ],
      "parameters": [
        { "name": "resolution", "label": "Resolution", "type": "enum", "api_field": "resolution", "default": "720p", "options": ["480p", "720p", "1080p"] },
        { "name": "duration", "label": "Duration (sec)", "type": "int", "api_field": "duration", "default": 8, "min": 4, "max": 30 },
        { "name": "generate_audio", "label": "Audio", "type": "bool", "api_field": "generate_audio", "default": true },
        { "name": "output_format", "label": "Output Format", "type": "enum", "api_field": "output_format", "default": "mp4", "options": ["mp4", "mov"] },
        { "name": "watermark", "label": "Watermark", "type": "bool", "api_field": "watermark", "default": false }
      ]
    },
    {
      "id": "bytedance_seedance25_ref2vid",
      "name": "Seedance 2.5 (ref2vid)",
      "endpoint": "dreamina-seedance-2-5-260628",
      "inputs": [
        { "name": "prompt", "data_type": "STRING", "api_field": "prompt", "required": true },
        { "name": "image_refs", "data_type": "IMAGE", "api_field": "reference_image_urls", "api_format": "array", "max": 30 },
        { "name": "video_refs", "data_type": "VIDEO", "api_field": "reference_video_urls", "api_format": "array", "max": 10 },
        { "name": "audio_refs", "data_type": "AUDIO", "api_field": "reference_audio_urls", "api_format": "array", "max": 10 }
      ],
      "outputs": [
        { "name": "video", "data_type": "VIDEO", "api_field": "video" }
      ],
      "ref_roles": [
        { "role": "image", "api_field": "reference_image_urls", "max": 30 }
      ],
      "parameters": [
        { "name": "resolution", "label": "Resolution", "type": "enum", "api_field": "resolution", "default": "720p", "options": ["480p", "720p", "1080p"] },
        { "name": "ratio", "label": "Aspect Ratio", "type": "enum", "api_field": "ratio", "default": "adaptive", "options": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"] },
        { "name": "duration", "label": "Duration (sec)", "type": "int", "api_field": "duration", "default": 8, "min": 4, "max": 30 },
        { "name": "generate_audio", "label": "Audio", "type": "bool", "api_field": "generate_audio", "default": true },
        { "name": "output_format", "label": "Output Format", "type": "enum", "api_field": "output_format", "default": "mp4", "options": ["mp4", "mov"] },
        { "name": "watermark", "label": "Watermark", "type": "bool", "api_field": "watermark", "default": false }
      ]
    }
  ]
}
