# aiSLAP provider keys.
#
# NOTE: the live file is NOT read from the repo root — it lives at
#   Windows:     %APPDATA%\aiSLAP\.env
#   macOS/Linux: the equivalent app-config dir
# The Settings dialog (gear icon) writes these for you; this file just
# documents the expected variables.
#
# Rolling this out to a studio? Every one of these (lowercased, same names)
# can instead live in a single read-only YAML file on a network share, so
# nobody has to paste keys into each machine by hand — see docs/providers.md
# §3a "Shared config". A local value here always wins over the shared file.

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ByteDance (BytePlus Ark) — https://console.byteplus.com/ark
# Seedance / Seedream generation.
BYTEDANCE_API_KEY=

# BytePlus VOD AI MediaKit — video enhancement. A *different* API and a
# *different* key from Ark above, served by the same `bytedance` provider and
# selected by the endpoint. Set this only if you use the enhancement models.
BYTEDANCE_MEDIAKIT_API_KEY=

# Beeble (beeble.ai) — SwitchX relighting / background replacement.
# https://developer.beeble.ai/api-keys — the key is shown once on creation.
BEEBLE_API_KEY=

# BytePlus TOS object storage — hosts reference images/video/audio as
# fetchable URLs for ByteDance generations (Ark doesn't accept inline data).
# Create an access key on the BytePlus console; bucket/region/endpoint are
# set in Settings, not here.
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=

# Turso (optional) — syncs the local SQLite asset index to a shared cloud
# database. Leave unset to keep everything local-only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Any other provider falls back to <PROVIDER>_API_KEY (uppercased).
